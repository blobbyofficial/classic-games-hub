# ── Supabase ──────────────────────────────────────────────────────────────
# Publishable values - safe to expose to the browser (protected by RLS).
# Values below are the live "classic-games-hub" Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://isgqukmmhuzhpalbruwt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_K6DD29odFaDeNTYozEsifQ_rD1ThsG5

# Server-only. Get it from Supabase Dashboard → Settings → API keys.
# Required for admin server actions that bypass RLS (never expose to client).
SUPABASE_SECRET_KEY=

# ── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://classic-games-hub.blobbyofficial.com

# ── GIFs (messaging) ──────────────────────────────────────────────────────
# Server-only Giphy API key powering the in-chat GIF picker. Get one at
# https://developers.giphy.com (create an app → API key). Without it the GIF
# picker simply shows no results; messaging otherwise works unchanged.
GIPHY_API_KEY=

# ── Discord bot (serverless interactions on Vercel) ───────────────────────
# All server-only. See docs/discord-bot.md for full setup.
# From https://discord.com/developers/applications → your application:
DISCORD_CLIENT_ID=          # General Information → Application ID
DISCORD_PUBLIC_KEY=         # General Information → Public Key
DISCORD_BOT_TOKEN=          # Bot → Token (keep secret)
DISCORD_GUILD_ID=           # Your Discord server's ID
# Protects /api/cron/* and /api/discord/register. Any long random string:
CRON_SECRET=
