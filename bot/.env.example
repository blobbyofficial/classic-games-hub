# ── Discord ───────────────────────────────────────────────────────────────
# From https://discord.com/developers/applications → your app.
DISCORD_TOKEN=              # Bot → Token (keep secret)
                            # DISCORD_BOT_TOKEN also works - the website uses that name
DISCORD_GUILD_ID=           # Your server's ID

# ── Supabase (server-only) ────────────────────────────────────────────────
# The SECRET key - never the publishable/anon one. Supabase Dashboard →
# Settings → API keys → secret. This grants service_role access; keep it
# only here on the bot host, never in the web repo.
SUPABASE_URL=https://isgqukmmhuzhpalbruwt.supabase.co
SUPABASE_SECRET_KEY=

# ── Hub ───────────────────────────────────────────────────────────────────
SITE_URL=https://classic-games-hub.blobbyofficial.com

# ── Staying online ────────────────────────────────────────────────────────
# The worker serves GET /health on $PORT so hosts (Render, Koyeb, Fly…) see a
# healthy web service. Most hosts set PORT themselves; 8080 is the default.
PORT=8080
# This service's own public URL. When set, the worker pings itself every 4
# minutes, which stops free hosts idling it out (an idled worker = a bot that
# shows as offline).
SELF_URL=

# What Discord shows next to the bot's name.
# PRESENCE_TYPE: playing | watching | listening | competing
# PRESENCE_STATUS: online | idle | dnd | invisible
PRESENCE_TEXT=classic-games-hub.blobbyofficial.com
PRESENCE_TYPE=playing
PRESENCE_STATUS=online

# ── Optional ──────────────────────────────────────────────────────────────
# Set to "true" only if you've enabled the Message Content privileged intent
# in the Developer Portal. Needed for the automod invite/link rules; XP,
# mention and flood rules work without it.
MESSAGE_CONTENT_INTENT=false

LIVE_SCORES_CHANNEL_ID=     # Channel for the live score/achievement feed

# Legacy stat-counter channel IDs. `/setup stats` stores these in Supabase
# instead - these are only a fallback for existing deployments.
STATS_MEMBERS_CHANNEL_ID=
STATS_ONLINE_CHANNEL_ID=
STATS_PLAYS_CHANNEL_ID=

# Leveling, verification, tickets, moderation and counter configuration all
# live in Supabase (discord_bot_config) and are edited from the website's
# admin dashboard (Admin → Discord bot) or with /setup in Discord.
