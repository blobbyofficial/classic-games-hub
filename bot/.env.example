# ── Discord ───────────────────────────────────────────────────────────────
# From https://discord.com/developers/applications → your app.
DISCORD_TOKEN=              # Bot → Token (keep secret)
DISCORD_CLIENT_ID=          # General Information → Application ID
DISCORD_GUILD_ID=           # Your server's ID (for instant guild command registration)

# ── Supabase (server-only) ────────────────────────────────────────────────
# The SECRET key — never the publishable/anon one. Supabase Dashboard →
# Settings → API keys → secret. This grants service_role access; keep it
# only here on the bot host, never in the web repo.
SUPABASE_URL=https://isgqukmmhuzhpalbruwt.supabase.co
SUPABASE_SECRET_KEY=

# ── Hub ───────────────────────────────────────────────────────────────────
SITE_URL=https://classic-games-hub.blobbyofficial.com

# ── Optional feature channels (leave blank to disable that feature) ────────
LIVE_SCORES_CHANNEL_ID=     # Channel for the live score/achievement feed
# Voice channels whose names become live counters (bot renames them):
STATS_MEMBERS_CHANNEL_ID=
STATS_ONLINE_CHANNEL_ID=
STATS_PLAYS_CHANNEL_ID=

# ── Role sync (optional) ──────────────────────────────────────────────────
# JSON mapping of Hub award slug -> Discord role id, applied by /sync and on
# level-up. Example:
# {"badge-og":"1111","leaderboard-top3":"2222","__staff__":"3333","nameplate-galaxy":"4444"}
# Special keys: "__staff__" (admins/mods), "nameplate-<slug>" (color roles).
ROLE_MAP={}
