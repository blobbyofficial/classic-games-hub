# Production defaults for the build.
#
# These are PUBLISHABLE values — they are safe to commit and ship to the
# browser. All data access is governed by Row Level Security in Postgres, so
# the anon/publishable key cannot read or write anything a signed-out (or
# signed-in) user isn't already allowed to. Next.js inlines NEXT_PUBLIC_* at
# build time. Vercel dashboard env vars, if set, override these.
#
# The server-only SUPABASE_SECRET_KEY is intentionally NOT here — it must only
# ever be set as a private environment variable in Vercel if you need it.

NEXT_PUBLIC_SUPABASE_URL=https://intwdtzlfnvsqdzuetwt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_0urRc5lUy8s39D4-269mnQ_i_4Yujas
NEXT_PUBLIC_SITE_URL=https://classic-games-hub.blobbyofficial.com
